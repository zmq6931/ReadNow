<Window x:Class="ReadNow.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        MinWidth="480" MaxWidth="680"
        FontFamily="Microsoft YaHei UI">
    <Border Background="#FDFDFD" CornerRadius="14" Padding="16"
            BorderBrush="#D0D0D0" BorderThickness="1"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown"
            ToolTip="按住空白处可拖动">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.28"/>
        </Border.Effect>

        <StackPanel>
            <!-- 文本预览 -->
            <TextBox x:Name="PreviewText" IsReadOnly="True" TextWrapping="Wrap"
                     MaxHeight="170" VerticalScrollBarVisibility="Auto"
                     BorderThickness="0" Background="Transparent"
                     FontSize="16" Foreground="#222"
                     ToolTip="识别 / 选取到的原文"/>

            <!-- 翻译结果（默认隐藏） -->
            <Border x:Name="TranslationPanel" Visibility="Collapsed" Margin="0,8,0,0"
                    Background="#EEF4FF" CornerRadius="10" Padding="12">
                <StackPanel>
                    <TextBlock x:Name="TranslationLabel" FontSize="13" Foreground="#5B7EC4"/>
                    <TextBox x:Name="TranslationText" IsReadOnly="True" TextWrapping="Wrap"
                             MaxHeight="170" VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent"
                             FontSize="16" Foreground="#1F3B73"/>
                </StackPanel>
            </Border>

            <!-- 状态行（OCR 中 / 翻译中 / 正在朗读…） -->
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontSize="13"
                       Foreground="#888" Visibility="Collapsed"/>

            <!-- 操作按钮行 -->
            <WrapPanel Margin="0,12,0,0">
                <Button x:Name="SpeakButton" Content="▶ 朗读" Click="SpeakButton_Click"
                        Padding="18,9" Margin="0,0,8,0" Cursor="Hand" FontSize="16"
                        Background="#2563EB" Foreground="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="StopButton" Content="⏹ 停止" Click="StopButton_Click"
                        Padding="14,9" Margin="0,0,8,0" Cursor="Hand" FontSize="15"
                        ToolTip="停止朗读（记住位置）"
                        Background="#E5E7EB" Foreground="#374151" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="RestartButton" Content="↻ 重读" Click="RestartButton_Click"
                        Padding="14,9" Margin="0,0,10,0" Cursor="Hand" FontSize="15"
                        ToolTip="从头朗读"
                        Background="#E5E7EB" Foreground="#374151" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Slider x:Name="SpeedSlider" Width="150" VerticalAlignment="Center"
                        Minimum="0.5" Maximum="4.0" TickFrequency="0.25"
                        IsSnapToTickEnabled="True" Margin="6,0,2,0"
                        ToolTip="朗读速度（拖动调节，自动记忆）"
                        ValueChanged="SpeedSlider_ValueChanged"/>
                <TextBlock x:Name="SpeedLabel" Text="1.0x" Width="52"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           FontSize="15" Foreground="#374151"/>

                <Button Content="📋 复制" Click="CopyButton_Click"
                        Padding="14,9" Margin="0,0,8,0" Cursor="Hand" FontSize="15"
                        ToolTip="复制全部文字到剪贴板"
                        Background="#E5E7EB" Foreground="#374151" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="译英" Click="TranslateToEnglish_Click"
                        Padding="14,9" Margin="0,0,8,0" Cursor="Hand" FontSize="15"
                        ToolTip="翻译成英文"
                        Background="#E5E7EB" Foreground="#374151" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="译中" Click="TranslateToChinese_Click"
                        Padding="14,9" Margin="0,0,8,0" Cursor="Hand" FontSize="15"
                        ToolTip="翻译成中文"
                        Background="#E5E7EB" Foreground="#374151" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="✕" Click="CloseButton_Click"
                        Padding="12,9" Margin="4,0,0,0" Cursor="Hand" FontSize="15"
                        ToolTip="关闭 (Esc)"
                        Background="Transparent" Foreground="#9CA3AF" BorderThickness="0"/>
            </WrapPanel>

            <!-- 功能开关：与托盘菜单双向同步，自动记忆 -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <CheckBox x:Name="SelectionToggle" Content="划词朗读（含 Ctrl+A）"
                          FontSize="14" VerticalAlignment="Center" Margin="0,0,18,0"
                          Cursor="Hand" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                <CheckBox x:Name="ScreenshotToggle" Content="截图识别（Alt+Q / 自动）"
                          FontSize="14" VerticalAlignment="Center" Margin="0,0,18,0"
                          Cursor="Hand" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                <CheckBox x:Name="StartupToggle" Content="开机自动启动"
                          FontSize="14" VerticalAlignment="Center"
                          Cursor="Hand" ToolTip="登录 Windows 后自动在后台运行 ReadNow"
                          Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
